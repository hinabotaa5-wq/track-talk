# 開発用 DB は docker の PostgreSQL(make db)。本番の Supabase DB はここに書かない
DATABASE_URL=postgres://tracktalk:tracktalk@127.0.0.1:55432/tracktalk?sslmode=disable
API_ADDR=:8080
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=info

# Supabase Auth (server-side secrets — never expose to the browser)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_JWT_SECRET=
SUPABASE_JWT_AUD=authenticated
# API only. Deletes the Auth user during account withdrawal.
SUPABASE_SERVICE_ROLE_KEY=

# Cloudinary (API only — do not prefix these with NEXT_PUBLIC)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Next.js public values (anon key only)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
