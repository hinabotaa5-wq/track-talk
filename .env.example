# 開発用 DB は docker の PostgreSQL(make db)。本番の Supabase DB はここに書かない
DATABASE_URL=postgres://tracktalk:tracktalk@127.0.0.1:55432/tracktalk?sslmode=disable
API_ADDR=:8080
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=info

# Supabase Auth (server-side secrets — never expose to the browser)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_JWT_SECRET=
SUPABASE_JWT_AUD=authenticated
# API only. Deletes the Auth user during account withdrawal.
SUPABASE_SERVICE_ROLE_KEY=

# Cloudinary (API only — do not prefix these with NEXT_PUBLIC)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# トークン認証の鍵(16進数)。Cloudinary で authenticated の配信にトークン認証を有効にしてから入れる。空なら非公開動画の URL に期限が付かない。
CLOUDINARY_AUTH_TOKEN_KEY=

# Web Push (coaching notifications). Leave empty to disable.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Guardian consent links are mailed to the guardian via Resend (never returned to the minor).
# MAIL_DEV_LOG=1 logs the mail body instead of sending it (local only, never in production).
RESEND_API_KEY=
MAIL_FROM=
MAIL_DEV_LOG=

# Online coaching (birth month, guardian consent, push, coaching videos, personal
# contracts, form reviews, coach payouts) is not offered yet.
# Keep both off in production until launch; the privacy policy assumes they are off.
# While they are off the API returns 404 for those routes and the pages are Not Found.
# Coach applications and the admin review of them stay open so you can prepare.
COACHING_ENABLED=
# New applications, ticket purchases, and paid consultations. Keep empty to pause intake
# while existing contracts, webhooks, refunds, and scheduled processing continue.
COACHING_NEW_ACCEPTANCE_ENABLED=
NEXT_PUBLIC_COACHING_ENABLED=
# Paid one-to-one messaging (contract messages, paid consultations, review clarifications).
# Keep both empty until the telecommunications business notification has been accepted.
COACHING_MESSAGING_ENABLED=
NEXT_PUBLIC_COACHING_MESSAGING_ENABLED=
# 32-byte base64 key that encrypts coaches' legal name, address and phone (openssl rand -base64 32).
# Keep it outside the database. Changing it makes the stored identities unreadable.
COACH_IDENTITY_KEY=

# Weekly AI summary of sense notes. The notes are sent to Gemini only when the user asks.
# Keep both off in production until the privacy policy change is deployed.
# GEMINI_API_KEY is the same key the competition import uses; without it the summary returns 503.
# The free tier may use submitted content to improve Google products; use a paid key before real users write notes.
SENSE_SUMMARY_ENABLED=
NEXT_PUBLIC_SENSE_SUMMARY_ENABLED=
GEMINI_API_KEY=
# All users combined: API attempts in rolling windows, including failures. Explicit 0 disables a limit.
SENSE_SUMMARY_DAILY_LIMIT=400
SENSE_SUMMARY_MINUTE_LIMIT=10

# Two-step login (TOTP) for staff. When on, admin and approved-coach API calls need an aal2 session.
# Turn on only after every admin and coach has set up two-step login on /me/security.
STAFF_MFA_REQUIRED=
# Cloudflare Turnstile site key for sign-up, login and password reset. Empty = no CAPTCHA widget.
# Set this and redeploy the Web first, then turn on CAPTCHA protection (Turnstile + secret key) in Supabase Auth.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Next.js public values (anon key only)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional PostHog analytics. Leave both empty to disable. Public project key only.
# Free account without a payment card; turn on "Discard client IP data" in PostHog.
# Set the ingestion host to https://us.i.posthog.com or https://eu.i.posthog.com.
# Add these to the Web hosting build environment and rebuild to enable.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=
