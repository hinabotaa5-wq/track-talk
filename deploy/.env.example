# 本番サーバー（/opt/track-talk/.env）用。ローカル開発用はリポジトリ直下の .env.example。
# このファイルをサーバーにコピーして値を入れる。Git にコミットしない。

# 公開する API のドメイン（A レコードをサーバーの IP に向けておく）
API_DOMAIN=api.example.com
# GitHub Actions が push するイメージ。OWNER/REPO は小文字で。
API_IMAGE=ghcr.io/OWNER/track-talk-api:latest

DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/postgres?sslmode=require
# Netlify の URL。複数あるときはカンマ区切り
CORS_ORIGINS=https://YOUR_SITE.netlify.app
LOG_LEVEL=info

SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_JWT_SECRET=
SUPABASE_JWT_AUD=authenticated
SUPABASE_SERVICE_ROLE_KEY=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# トークン認証の鍵(16進数)。Cloudinary で authenticated の配信にトークン認証を有効にしてから入れる。空なら非公開動画の URL に期限が付かない。
CLOUDINARY_AUTH_TOKEN_KEY=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
# オンラインコーチングは提供前。始めるまで空のままにする。
# 空の間は保護者の同意・決済、パーソナル指導、フォーム添削、プッシュ通知、
# コーチの報酬と送金、運営の送金が 404 になり、コーチの応募と運営の審査だけが残る。
COACHING_ENABLED=
# 感覚メモの1週間のまとめ（AI）。感覚メモを Gemini に送る。大会の取り込みと同じ GEMINI_API_KEY を使う。
SENSE_SUMMARY_ENABLED=
GEMINI_API_KEY=
